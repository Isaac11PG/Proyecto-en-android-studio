<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificando estado..."
            android:textSize="14sp"
            android:background="@color/white"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prueba de Notificaciones Inmediatas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnTestBreathing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌬️ Probar Notificación de Respiración"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnTestJournal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Probar Notificación de Diario"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnTestMotivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ Probar Mensaje Motivacional"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnTestAchievement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏆 Probar Notificación de Logro"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración de Alarmas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnScheduleAlarms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Programar Todas las Alarmas"
            android:backgroundTint="@color/accent"/>

    </LinearLayout>
</ScrollView>